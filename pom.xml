<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.bonitasoft.connectors</groupId>
    <artifactId>bonita-connector-msteams</artifactId>
    <version>1.0.0-beta.1</version>
    <packaging>jar</packaging>

    <name>Bonita Connector - Microsoft Teams</name>
    <description>Bonita BPM connector for Microsoft Teams integration (messages, channels, teams, meetings, files)</description>
    <url>https://www.bonitasoft.com</url>

    <developers>
        <developer>
            <id>bonitasoft</id>
            <name>Bonitasoft</name>
            <email>rd.user@bonitasoft.com</email>
            <organization>Bonitasoft</organization>
            <organizationUrl>https://www.bonitasoft.com</organizationUrl>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>GNU General Public License v2.0</name>
            <url>https://www.gnu.org/licenses/old-licenses/gpl-2.0.html</url>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>

        <!-- Bonita -->
        <bonita.runtime.version>10.2.0</bonita.runtime.version>

        <!-- Auth -->
        <msal4j.version>1.17.2</msal4j.version>

        <!-- JSON -->
        <jackson.version>2.17.2</jackson.version>

        <!-- Tools -->
        <lombok.version>1.18.30</lombok.version>

        <!-- Testing -->
        <junit.version>5.10.2</junit.version>
        <mockito.version>5.11.0</mockito.version>
        <assertj.version>3.27.7</assertj.version>
        <jacoco.version>0.8.12</jacoco.version>
        <pitest.version>1.15.8</pitest.version>
        <jqwik.version>1.8.4</jqwik.version>
        <wiremock.version>3.5.4</wiremock.version>
        <testcontainers.version>1.19.7</testcontainers.version>
        <slf4j.version>2.0.12</slf4j.version>
        <failsafe.version>3.2.5</failsafe.version>
        <awaitility.version>4.2.0</awaitility.version>

        <!-- Connector definition properties - Send Channel Message -->
        <msteams-send-channel-message.def.id>msteams-send-channel-message</msteams-send-channel-message.def.id>
        <msteams-send-channel-message.def.version>1.0.0-beta.1</msteams-send-channel-message.def.version>
        <msteams-send-channel-message.impl.id>${msteams-send-channel-message.def.id}-impl</msteams-send-channel-message.impl.id>
        <msteams-send-channel-message.impl.version>${project.version}</msteams-send-channel-message.impl.version>
        <msteams-send-channel-message.main-class>com.bonitasoft.connectors.msteams.messaging.SendChannelMessageConnector</msteams-send-channel-message.main-class>

        <!-- Send Adaptive Card -->
        <msteams-send-adaptive-card.def.id>msteams-send-adaptive-card</msteams-send-adaptive-card.def.id>
        <msteams-send-adaptive-card.def.version>1.0.0-beta.1</msteams-send-adaptive-card.def.version>
        <msteams-send-adaptive-card.impl.id>${msteams-send-adaptive-card.def.id}-impl</msteams-send-adaptive-card.impl.id>
        <msteams-send-adaptive-card.impl.version>${project.version}</msteams-send-adaptive-card.impl.version>
        <msteams-send-adaptive-card.main-class>com.bonitasoft.connectors.msteams.messaging.SendAdaptiveCardConnector</msteams-send-adaptive-card.main-class>

        <!-- Send Chat Message -->
        <msteams-send-chat-message.def.id>msteams-send-chat-message</msteams-send-chat-message.def.id>
        <msteams-send-chat-message.def.version>1.0.0-beta.1</msteams-send-chat-message.def.version>
        <msteams-send-chat-message.impl.id>${msteams-send-chat-message.def.id}-impl</msteams-send-chat-message.impl.id>
        <msteams-send-chat-message.impl.version>${project.version}</msteams-send-chat-message.impl.version>
        <msteams-send-chat-message.main-class>com.bonitasoft.connectors.msteams.messaging.SendChatMessageConnector</msteams-send-chat-message.main-class>

        <!-- Reply Message -->
        <msteams-reply-message.def.id>msteams-reply-message</msteams-reply-message.def.id>
        <msteams-reply-message.def.version>1.0.0-beta.1</msteams-reply-message.def.version>
        <msteams-reply-message.impl.id>${msteams-reply-message.def.id}-impl</msteams-reply-message.impl.id>
        <msteams-reply-message.impl.version>${project.version}</msteams-reply-message.impl.version>
        <msteams-reply-message.main-class>com.bonitasoft.connectors.msteams.messaging.ReplyMessageConnector</msteams-reply-message.main-class>

        <!-- List Channels -->
        <msteams-list-channels.def.id>msteams-list-channels</msteams-list-channels.def.id>
        <msteams-list-channels.def.version>1.0.0-beta.1</msteams-list-channels.def.version>
        <msteams-list-channels.impl.id>${msteams-list-channels.def.id}-impl</msteams-list-channels.impl.id>
        <msteams-list-channels.impl.version>${project.version}</msteams-list-channels.impl.version>
        <msteams-list-channels.main-class>com.bonitasoft.connectors.msteams.channels.ListChannelsConnector</msteams-list-channels.main-class>

        <!-- Create Channel -->
        <msteams-create-channel.def.id>msteams-create-channel</msteams-create-channel.def.id>
        <msteams-create-channel.def.version>1.0.0-beta.1</msteams-create-channel.def.version>
        <msteams-create-channel.impl.id>${msteams-create-channel.def.id}-impl</msteams-create-channel.impl.id>
        <msteams-create-channel.impl.version>${project.version}</msteams-create-channel.impl.version>
        <msteams-create-channel.main-class>com.bonitasoft.connectors.msteams.channels.CreateChannelConnector</msteams-create-channel.main-class>

        <!-- Delete Channel -->
        <msteams-delete-channel.def.id>msteams-delete-channel</msteams-delete-channel.def.id>
        <msteams-delete-channel.def.version>1.0.0-beta.1</msteams-delete-channel.def.version>
        <msteams-delete-channel.impl.id>${msteams-delete-channel.def.id}-impl</msteams-delete-channel.impl.id>
        <msteams-delete-channel.impl.version>${project.version}</msteams-delete-channel.impl.version>
        <msteams-delete-channel.main-class>com.bonitasoft.connectors.msteams.channels.DeleteChannelConnector</msteams-delete-channel.main-class>

        <!-- List Teams -->
        <msteams-list-teams.def.id>msteams-list-teams</msteams-list-teams.def.id>
        <msteams-list-teams.def.version>1.0.0-beta.1</msteams-list-teams.def.version>
        <msteams-list-teams.impl.id>${msteams-list-teams.def.id}-impl</msteams-list-teams.impl.id>
        <msteams-list-teams.impl.version>${project.version}</msteams-list-teams.impl.version>
        <msteams-list-teams.main-class>com.bonitasoft.connectors.msteams.teams.ListTeamsConnector</msteams-list-teams.main-class>

        <!-- Get Team -->
        <msteams-get-team.def.id>msteams-get-team</msteams-get-team.def.id>
        <msteams-get-team.def.version>1.0.0-beta.1</msteams-get-team.def.version>
        <msteams-get-team.impl.id>${msteams-get-team.def.id}-impl</msteams-get-team.impl.id>
        <msteams-get-team.impl.version>${project.version}</msteams-get-team.impl.version>
        <msteams-get-team.main-class>com.bonitasoft.connectors.msteams.teams.GetTeamConnector</msteams-get-team.main-class>

        <!-- Add Member -->
        <msteams-add-member.def.id>msteams-add-member</msteams-add-member.def.id>
        <msteams-add-member.def.version>1.0.0-beta.1</msteams-add-member.def.version>
        <msteams-add-member.impl.id>${msteams-add-member.def.id}-impl</msteams-add-member.impl.id>
        <msteams-add-member.impl.version>${project.version}</msteams-add-member.impl.version>
        <msteams-add-member.main-class>com.bonitasoft.connectors.msteams.teams.AddMemberConnector</msteams-add-member.main-class>

        <!-- Remove Member -->
        <msteams-remove-member.def.id>msteams-remove-member</msteams-remove-member.def.id>
        <msteams-remove-member.def.version>1.0.0-beta.1</msteams-remove-member.def.version>
        <msteams-remove-member.impl.id>${msteams-remove-member.def.id}-impl</msteams-remove-member.impl.id>
        <msteams-remove-member.impl.version>${project.version}</msteams-remove-member.impl.version>
        <msteams-remove-member.main-class>com.bonitasoft.connectors.msteams.teams.RemoveMemberConnector</msteams-remove-member.main-class>

        <!-- Create Meeting -->
        <msteams-create-meeting.def.id>msteams-create-meeting</msteams-create-meeting.def.id>
        <msteams-create-meeting.def.version>1.0.0-beta.1</msteams-create-meeting.def.version>
        <msteams-create-meeting.impl.id>${msteams-create-meeting.def.id}-impl</msteams-create-meeting.impl.id>
        <msteams-create-meeting.impl.version>${project.version}</msteams-create-meeting.impl.version>
        <msteams-create-meeting.main-class>com.bonitasoft.connectors.msteams.meetings.CreateMeetingConnector</msteams-create-meeting.main-class>

        <!-- Get Meeting -->
        <msteams-get-meeting.def.id>msteams-get-meeting</msteams-get-meeting.def.id>
        <msteams-get-meeting.def.version>1.0.0-beta.1</msteams-get-meeting.def.version>
        <msteams-get-meeting.impl.id>${msteams-get-meeting.def.id}-impl</msteams-get-meeting.impl.id>
        <msteams-get-meeting.impl.version>${project.version}</msteams-get-meeting.impl.version>
        <msteams-get-meeting.main-class>com.bonitasoft.connectors.msteams.meetings.GetMeetingConnector</msteams-get-meeting.main-class>

        <!-- Upload File -->
        <msteams-upload-file.def.id>msteams-upload-file</msteams-upload-file.def.id>
        <msteams-upload-file.def.version>1.0.0-beta.1</msteams-upload-file.def.version>
        <msteams-upload-file.impl.id>${msteams-upload-file.def.id}-impl</msteams-upload-file.impl.id>
        <msteams-upload-file.impl.version>${project.version}</msteams-upload-file.impl.version>
        <msteams-upload-file.main-class>com.bonitasoft.connectors.msteams.files.UploadFileConnector</msteams-upload-file.main-class>
    </properties>

    <dependencies>
        <!-- Bonita -->
        <dependency>
            <groupId>org.bonitasoft.engine</groupId>
            <artifactId>bonita-common</artifactId>
            <version>${bonita.runtime.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- MSAL4J for Azure AD authentication -->
        <dependency>
            <groupId>com.microsoft.azure</groupId>
            <artifactId>msal4j</artifactId>
            <version>${msal4j.version}</version>
        </dependency>

        <!-- Jackson for JSON processing (provided by Bonita runtime) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>net.jqwik</groupId>
            <artifactId>jqwik</artifactId>
            <version>${jqwik.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>${awaitility.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>${slf4j.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <filtering>true</filtering>
                <directory>src/main/resources-filtered</directory>
            </resource>
            <resource>
                <filtering>false</filtering>
                <directory>src/main/resources</directory>
            </resource>
        </resources>

        <plugins>
            <!-- Compiler -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.12.1</version>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Groovy (generate dependencies variable for .impl files) -->
            <plugin>
                <groupId>org.codehaus.gmaven</groupId>
                <artifactId>groovy-maven-plugin</artifactId>
                <version>2.1.1</version>
                <executions>
                    <execution>
                        <phase>generate-resources</phase>
                        <goals><goal>execute</goal></goals>
                        <configuration>
                            <source>${project.basedir}/src/script/dependencies-as-var.groovy</source>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>org.codehaus.groovy</groupId>
                        <artifactId>groovy-xml</artifactId>
                        <version>3.0.24</version>
                    </dependency>
                </dependencies>
            </plugin>

            <!-- Surefire (unit tests) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${failsafe.version}</version>
                <configuration>
                    <excludedGroups>integration</excludedGroups>
                </configuration>
            </plugin>

            <!-- Failsafe (integration tests) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${failsafe.version}</version>
                <configuration>
                    <groups>integration</groups>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- JaCoCo -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Pitest -->
            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>1.2.1</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <mutators>
                        <mutator>STRONGER</mutator>
                    </mutators>
                    <mutationThreshold>85</mutationThreshold>
                    <targetClasses>
                        <param>com.bonitasoft.connectors.msteams.common.*</param>
                    </targetClasses>
                </configuration>
            </plugin>

            <!-- Source JAR (required for Maven Central) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals><goal>jar-no-fork</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Javadoc JAR (required for Maven Central) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.7.0</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals><goal>jar</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Central Publishing (Maven Central) -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <version>0.8.0</version>
                <extensions>true</extensions>
                <configuration>
                    <autoPublish>true</autoPublish>
                </configuration>
            </plugin>

            <!-- Shade (fat JAR with -bonita classifier) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <shadedArtifactAttached>true</shadedArtifactAttached>
                            <shadedClassifierName>bonita</shadedClassifierName>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer"/>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>bonitasoft-releases</id>
            <url>https://bonitasoft.jfrog.io/artifactory/maven</url>
        </repository>
    </repositories>

    <scm>
        <connection>scm:git:git://github.com/bonitasoft/bonita-connector-msteams.git</connection>
        <developerConnection>scm:git:ssh://github.com:bonitasoft/bonita-connector-msteams.git</developerConnection>
        <url>https://github.com/bonitasoft/bonita-connector-msteams</url>
        <tag>HEAD</tag>
    </scm>

    <profiles>
        <profile>
            <id>deploy</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>ITs</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>E2E</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <groups>e2e</groups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
