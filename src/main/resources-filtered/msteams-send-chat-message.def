<?xml version="1.0" encoding="UTF-8"?>
<definition:ConnectorDefinition
    xmlns:definition="http://www.bonitasoft.org/ns/connector/definition/6.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <id>${msteams.send-chat-message.def.id}</id>
    <version>${msteams.send-chat-message.def.version}</version>
    <icon>msteams.png</icon>
    <category icon="msteams.png" id="MicrosoftTeams"/>

    <input name="tenantId" type="java.lang.String" mandatory="true"/>
    <input name="clientId" type="java.lang.String" mandatory="true"/>
    <input name="clientSecret" type="java.lang.String" mandatory="true"/>
    <input name="refreshToken" type="java.lang.String" mandatory="true"/>
    <input name="connectTimeout" type="java.lang.Integer" mandatory="false"/>
    <input name="chatId" type="java.lang.String" mandatory="true"/>
    <input name="message" type="java.lang.String" mandatory="true"/>
    <input name="contentType" type="java.lang.String" mandatory="false"/>

    <output name="success" type="java.lang.Boolean"/>
    <output name="errorMessage" type="java.lang.String"/>
    <output name="messageId" type="java.lang.String"/>
    <output name="createdDateTime" type="java.lang.String"/>

    <page id="connectionPage">
        <widget xsi:type="definition:Text" id="tenantIdWidget" inputName="tenantId"/>
        <widget xsi:type="definition:Text" id="clientIdWidget" inputName="clientId"/>
        <widget xsi:type="definition:Password" id="clientSecretWidget" inputName="clientSecret"/>
        <widget xsi:type="definition:Password" id="refreshTokenWidget" inputName="refreshToken"/>
        <widget xsi:type="definition:Text" id="connectTimeoutWidget" inputName="connectTimeout"/>
    </page>
    <page id="messagePage">
        <widget xsi:type="definition:Text" id="chatIdWidget" inputName="chatId"/>
        <widget xsi:type="definition:TextArea" id="messageWidget" inputName="message"/>
        <widget xsi:type="definition:Text" id="contentTypeWidget" inputName="contentType"/>
    </page>
</definition:ConnectorDefinition>
