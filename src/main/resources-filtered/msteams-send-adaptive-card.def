<?xml version="1.0" encoding="UTF-8"?>
<definition:ConnectorDefinition
    xmlns:definition="http://www.bonitasoft.org/ns/connector/definition/6.1"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <id>${msteams.send-adaptive-card.def.id}</id>
    <version>${msteams.send-adaptive-card.def.version}</version>
    <icon>msteams.png</icon>

    <category icon="msteams.png" id="MicrosoftTeams"/>

    <input name="webhookUrl" type="java.lang.String" mandatory="true"/>
    <input name="connectTimeout" type="java.lang.Integer" mandatory="false"/>
    <input name="cardTitle" type="java.lang.String" mandatory="false"/>
    <input name="cardBody" type="java.lang.String" mandatory="false"/>
    <input name="themeColor" type="java.lang.String" mandatory="false"/>
    <input name="factsJson" type="java.lang.String" mandatory="false"/>
    <input name="actionsJson" type="java.lang.String" mandatory="false"/>
    <input name="advancedCardJson" type="java.lang.String" mandatory="false"/>

    <output name="success" type="java.lang.Boolean"/>
    <output name="errorMessage" type="java.lang.String"/>

    <page id="connectionPage">
        <widget xsi:type="definition:Text" id="webhookUrlWidget" inputName="webhookUrl"/>
        <widget xsi:type="definition:Text" id="connectTimeoutWidget" inputName="connectTimeout"/>
    </page>
    <page id="cardPage">
        <widget xsi:type="definition:Text" id="cardTitleWidget" inputName="cardTitle"/>
        <widget xsi:type="definition:TextArea" id="cardBodyWidget" inputName="cardBody"/>
        <widget xsi:type="definition:Text" id="themeColorWidget" inputName="themeColor"/>
        <widget xsi:type="definition:TextArea" id="factsJsonWidget" inputName="factsJson"/>
        <widget xsi:type="definition:TextArea" id="actionsJsonWidget" inputName="actionsJson"/>
    </page>
    <page id="advancedPage">
        <widget xsi:type="definition:TextArea" id="advancedCardJsonWidget" inputName="advancedCardJson"/>
    </page>
</definition:ConnectorDefinition>
